DATABASE_URL=          # role dono das tabelas — só migrate.ts/seed.ts/admin-client.ts usam
APP_DATABASE_URL=      # role parciva_app (infra/init-db.sql), NÃO superusuário — runtime real, ver src/db/client.ts
REDIS_URL=

STORAGE_ROOT=
STORAGE_MAX_DISK_USAGE_PCT=
FILE_ENCRYPTION_KEY=        # gerar abaixo
ENCRYPTION_KEY=             # gerar abaixo — 32 bytes base64 (openssl rand -base64 32); cifra o segredo TOTP do MFA (src/shared/crypto.ts)
DOCUMENT_HASH_PEPPER=       # gerar abaixo
SESSION_SECRET=             # gerar abaixo

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=          # o token que você anotou
TWILIO_WHATSAPP_FROM=

ADMIN_SECRET=               # qualquer string para o painel admin

PSP_ENABLED=

ANTHROPIC_API_KEY=          # chave da API da Anthropic

APP_BASE_URL=                    # URL pública do app (returnUrl/completionUrl da AbacatePay)
ABACATE_PAY_API_KEY=              # chave de produção — cofre da AbacatePay, nunca logar
ABACATE_PAY_DEV_API_KEY=          # chave de dev/sandbox — usada fora de NODE_ENV=production
ABACATE_PAY_WEBHOOK_SECRET=       # segredo do webhook (query string ?webhookSecret= ao criar no painel)

RESEND_API_KEY=                  # chave da Resend — sem conta criada ainda (pendência, ver DECISIONS.md)
EMAIL_FROM_ADDRESS=               # ex.: "Parciva <contato@seudominio.com>" — sem isso usa o sandbox onboarding@resend.dev (dev only)

