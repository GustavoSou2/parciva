{
  "name": "parciva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch --env-file=.env src/workers/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tenant": "vitest run tests/security/tenant-isolation.test.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "pnpm lint && tsc --noEmit && pnpm test && pnpm check:tokens",
    "secrets:scan": "gitleaks detect --no-git",
    "format": "prettier --write .",
    "lint": "eslint src tests --ext .ts,.tsx",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.36.0",
    "ioredis": "^5.4.0",
    "next": "^15.0.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.0",
    "tesseract.js": "^7.0.0",
    "twilio": "^5.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-plugin-tailwindcss": "^3.17.0",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
